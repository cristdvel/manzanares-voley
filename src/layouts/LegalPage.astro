---
import Base from "./Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: site.url },
    { "@type": "ListItem", position: 2, name: title, item: new URL(Astro.url.pathname, site.url).href },
  ],
};
---

<Base title={`${title} | Manzanares Voley`} description={description} schemas={[breadcrumb]}>
  <Header />
  <main id="contenido">
    <div class="page-hero">
      <div class="container">
        <span class="eyebrow">Manzanares Voley</span>
        <h1>{title}</h1>
        <p class="page-hero__meta">Última actualización: {updated}</p>
      </div>
    </div>
    <article class="section legal">
      <div class="container">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</Base>
