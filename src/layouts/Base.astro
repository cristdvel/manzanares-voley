---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  schemas?: unknown[];
}
const {
  title = site.title,
  description = site.description,
  image = "/og.jpg",
  schemas = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;
const isHome = Astro.url.pathname === "/";
const tel = "+34" + site.telefono.replace(/\s/g, "");
const sameAs = [site.social.instagram, site.social.facebook, site.social.twitter].filter(
  (u) => u && u !== "#",
);

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "SportsOrganization",
  "@id": site.url + "#org",
  name: "Club Voleibol Manzanares",
  alternateName: "Manzanares Voley",
  url: site.url,
  logo: site.url + "favicon.png",
  image: ogImage,
  description: site.description,
  sport: "Volleyball",
  foundingDate: "2016-04",
  email: site.email,
  telephone: tel,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Calle Duquesa de Parcent 116",
    postalCode: "28047",
    addressLocality: "Madrid",
    addressRegion: "Comunidad de Madrid",
    addressCountry: "ES",
  },
  areaServed: { "@type": "City", name: "Madrid" },
  sameAs,
};
const siteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": site.url + "#website",
  url: site.url,
  name: site.title,
  inLanguage: "es-ES",
  publisher: { "@id": site.url + "#org" },
};
const allSchemas = [orgSchema, siteSchema, ...schemas];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1D1D24" />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/anton-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content="Club Voleibol Manzanares" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />
  </head>
  <body class={isHome ? "is-home" : undefined}>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <slot />

    <div id="cookie-banner" class="cookie-banner" hidden>
      <p class="cookie-banner__text">
        Usamos solo cookies técnicas necesarias. El mapa de Google Maps y otros contenidos
        externos no se cargan sin tu permiso. <a href="/cookies">Más información</a>.
      </p>
      <div class="cookie-banner__actions">
        <button type="button" data-cookie="reject" class="btn btn--outline">Solo necesarias</button>
        <button type="button" data-cookie="accept" class="btn btn--primary">Aceptar todo</button>
      </div>
    </div>

    <script is:inline>
      (function () {
        "use strict";

        // ---- Header: fondo al hacer scroll ----
        var header = document.getElementById("header");
        function onScroll() {
          header.classList.toggle("scrolled", window.scrollY > 50);
        }
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });

        // ---- Menú móvil ----
        var burger = document.getElementById("hamburger");
        var nav = document.getElementById("nav");
        burger.addEventListener("click", function () {
          var open = nav.classList.toggle("open");
          burger.setAttribute("aria-expanded", String(open));
          burger.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
        });
        nav.querySelectorAll("a").forEach(function (a) {
          a.addEventListener("click", function () {
            nav.classList.remove("open");
            burger.setAttribute("aria-expanded", "false");
            burger.setAttribute("aria-label", "Abrir menú");
          });
        });

        // ---- Scrollspy: enlace activo (solo en la home) ----
        var sections = Array.prototype.slice.call(document.querySelectorAll("main section[id]"));
        var navLinks = Array.prototype.slice.call(nav.querySelectorAll('.nav-links a[href*="#"]'));
        if (sections.length) {
          var spy = function () {
            var y = window.scrollY + 120;
            var current = sections[0].id;
            sections.forEach(function (s) {
              if (s.offsetTop <= y) current = s.id;
            });
            navLinks.forEach(function (a) {
              var href = a.getAttribute("href") || "";
              a.classList.toggle("active", href.split("#")[1] === current);
            });
          };
          spy();
          window.addEventListener("scroll", spy, { passive: true });
        }

        // ---- Tabs (agrupados por [data-tabs]) ----
        document.querySelectorAll("[data-tabs]").forEach(function (group) {
          var name = group.getAttribute("data-tabs");
          var scope = group.closest("section") || document;
          var tabs = Array.prototype.slice.call(group.querySelectorAll(".tab"));
          var panels = Array.prototype.slice.call(
            scope.querySelectorAll('.tab-panel[data-tabgroup="' + name + '"]'),
          );
          tabs.forEach(function (tab) {
            tab.addEventListener("click", function () {
              tabs.forEach(function (t) {
                t.classList.remove("active");
                t.setAttribute("aria-selected", "false");
              });
              panels.forEach(function (p) {
                p.classList.remove("active");
              });
              tab.classList.add("active");
              tab.setAttribute("aria-selected", "true");
              var target = panels.filter(function (p) {
                return p.getAttribute("data-cat") === tab.dataset.cat;
              })[0];
              if (target) target.classList.add("active");
            });
          });
        });

        // ---- Acordeón FAQ ----
        document.querySelectorAll(".faq-item").forEach(function (item) {
          var q = item.querySelector(".faq-q");
          q.addEventListener("click", function () {
            var open = item.classList.toggle("open");
            q.setAttribute("aria-expanded", String(open));
            q.querySelector(".ico").textContent = open ? "−" : "+";
          });
        });

        // ---- Categoría según fecha de nacimiento ----
        var dob = document.getElementById("dob");
        var catHint = document.getElementById("cat-hint");
        function categoriaPorEdad(age) {
          if (age < 9) return null;
          if (age <= 10) return "Minivoley";
          if (age === 11) return "Benjamín";
          if (age === 12) return "Alevín";
          if (age <= 14) return "Infantil";
          if (age <= 16) return "Cadete";
          if (age <= 18) return "Juvenil";
          return "Adultos";
        }
        function calcCategoria() {
          if (!dob.value) {
            catHint.classList.remove("show");
            return;
          }
          var b = new Date(dob.value);
          if (isNaN(b.getTime())) {
            catHint.classList.remove("show");
            return;
          }
          var now = new Date();
          var age = now.getFullYear() - b.getFullYear();
          var m = now.getMonth() - b.getMonth();
          if (m < 0 || (m === 0 && now.getDate() < b.getDate())) age--;
          var cat = categoriaPorEdad(age);
          if (age < 0 || age > 99) {
            catHint.classList.remove("show");
            return;
          }
          if (cat === null) {
            catHint.textContent =
              "Aún por debajo de la edad mínima (9 años). Escríbenos y te avisamos cuando pueda empezar.";
          } else {
            catHint.textContent = "Categoría orientativa: " + cat + " · " + age + " años";
          }
          catHint.classList.add("show");
        }
        if (dob) {
          dob.addEventListener("change", calcCategoria);
          dob.addEventListener("input", calcCategoria);
        }

        // ---- Validación del formulario ----
        var form = document.getElementById("insc-form");
        var success = document.getElementById("form-success");
        if (form) {
          var requeridos = Array.prototype.slice.call(form.querySelectorAll("[required]"));

          function wrapperDe(campo) {
            return campo.closest(".field") || campo.closest(".check");
          }

          function validaCampo(campo) {
            var malo = campo.type === "checkbox" ? !campo.checked : !campo.value.trim();
            if (
              campo.type === "email" &&
              campo.value.trim() &&
              !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(campo.value.trim())
            ) {
              malo = true;
            }
            var w = wrapperDe(campo);
            if (w) w.classList.toggle("field--error", malo);
            return !malo;
          }

          requeridos.forEach(function (campo) {
            var ev = campo.type === "checkbox" ? "change" : "input";
            campo.addEventListener(ev, function () {
              var w = wrapperDe(campo);
              if (w) w.classList.remove("field--error");
            });
          });

          form.addEventListener("submit", function (e) {
            e.preventDefault();
            var ok = true;
            requeridos.forEach(function (campo) {
              if (!validaCampo(campo)) ok = false;
            });
            if (!ok) {
              success.classList.remove("show");
              var primerError = form.querySelector(".field--error");
              if (primerError) primerError.scrollIntoView({ behavior: "smooth", block: "center" });
              return;
            }
            form.style.display = "none";
            success.classList.add("show");
            success.scrollIntoView({ behavior: "smooth", block: "center" });
          });
        }

        // ---- Consentimiento de cookies + carga diferida de embeds ----
        var CKEY = "mzv-consent";
        function getConsent() {
          try {
            return localStorage.getItem(CKEY);
          } catch (e) {
            return null;
          }
        }
        function setConsent(v) {
          try {
            localStorage.setItem(CKEY, v);
          } catch (e) {}
        }
        function loadEmbeds() {
          document.querySelectorAll("[data-embed-src]").forEach(function (box) {
            if (box.querySelector("iframe")) return;
            var f = document.createElement("iframe");
            f.src = box.getAttribute("data-embed-src");
            f.title = box.getAttribute("data-embed-title") || "Contenido embebido";
            f.loading = "lazy";
            f.setAttribute("referrerpolicy", "no-referrer-when-downgrade");
            f.allowFullscreen = true;
            box.innerHTML = "";
            box.appendChild(f);
          });
        }
        function applyConsent(v) {
          document.documentElement.setAttribute("data-consent", v);
          if (v === "accept") loadEmbeds();
        }
        var banner = document.getElementById("cookie-banner");
        var stored = getConsent();
        if (stored) {
          applyConsent(stored);
        } else if (banner) {
          banner.hidden = false;
        }
        if (banner) {
          banner.addEventListener("click", function (e) {
            var b = e.target.closest("[data-cookie]");
            if (!b) return;
            var v = b.getAttribute("data-cookie");
            setConsent(v);
            applyConsent(v);
            banner.hidden = true;
          });
        }
        // Botón "cargar mapa" dentro del placeholder
        document.querySelectorAll("[data-embed-load]").forEach(function (btn) {
          btn.addEventListener("click", function () {
            var box = btn.closest("[data-embed-src]");
            if (box) {
              var f = document.createElement("iframe");
              f.src = box.getAttribute("data-embed-src");
              f.title = box.getAttribute("data-embed-title") || "Mapa";
              f.loading = "lazy";
              f.allowFullscreen = true;
              box.innerHTML = "";
              box.appendChild(f);
            }
          });
        });
      })();
    </script>
  </body>
</html>
