---
import { productos } from "../data/productos";
const destacados = productos.slice(0, 3);
---
<div class="section section--crema">
  <div class="container">
    <span class="eyebrow">Tienda</span>
    <h2 class="section-title">Tienda oficial</h2>
    <p class="section-intro">
      Equipación de juego, ropa de entreno, sudadera del 10º aniversario y accesorios.
      Haz tu pedido online y recógelo en el pabellón.
    </p>
    <div class="tienda-grid">
      {destacados.map((p) => (
        <a class="producto" href="/tienda">
          <div class="producto__img">
            <img src={p.imagenes[0]} alt={p.nombre} loading="lazy" />
          </div>
          <div class="producto__body">
            <h3>{p.nombre}</h3>
            <p>{p.descripcion}</p>
            <span class="producto__link">Ver en la tienda →</span>
          </div>
        </a>
      ))}
    </div>
    <a href="/tienda" class="btn btn--primary btn--lg" style="margin-top:32px">Ver toda la tienda</a>
  </div>
</div>
