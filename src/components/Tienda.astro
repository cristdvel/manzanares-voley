---
import { productos } from "../data/contenido";
---
<div class="section section--crema">
  <div class="container">
    <span class="eyebrow">Tienda</span>
    <h2 class="section-title">Tienda oficial</h2>
    <div class="tienda-grid">
      {productos.map((p) => (
        <article class="producto">
          <div class="producto__img">
            <img src={p.img} alt={p.titulo} loading="lazy" />
          </div>
          <div class="producto__body">
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
            {p.href
              ? <a href={p.href} class="btn btn--primary">Ver productos</a>
              : <span class="producto__soon">Próximamente</span>}
          </div>
        </article>
      ))}
    </div>
  </div>
</div>
