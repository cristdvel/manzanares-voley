---
import { tiendaStripImg } from "../data/contenido";
---
<div class="section section--oscuro tienda-strip">
  <div class="container">
    <div class="split">
      <figure class="foto foto--4x3">
        <img src={tiendaStripImg} alt="Jugadoras con la equipación oficial del club" loading="lazy" />
      </figure>
      <div>
        <span class="eyebrow">Tienda oficial</span>
        <h2 class="section-title">Equipación oficial · 10º aniversario</h2>
        <p>Camisetas «Gatos» y «Claveles», sudadera del aniversario, ropa de entreno y accesorios del club.</p>
        <a href="/equipacion" class="btn btn--primary">Ver la colección</a>
      </div>
    </div>
  </div>
</div>
