---
import { tiendaStripImg } from "../data/contenido";
---
<div class="section section--oscuro tienda-strip">
  <div class="container">
    <div class="split">
      <div class="placeholder placeholder--accion">
        <img src={tiendaStripImg} alt="" loading="lazy" onerror="this.remove()" />
        <span class="placeholder__label">Foto pendiente</span>
      </div>
      <div>
        <span class="eyebrow">Tienda oficial</span>
        <h2 class="section-title">Equipación oficial · 10º aniversario</h2>
        <p>Camisetas, sudaderas y accesorios del club.</p>
        <a href="#tienda" class="btn btn--primary">Ver tienda</a>
      </div>
    </div>
  </div>
</div>
