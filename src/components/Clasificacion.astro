---
import { grupos as gruposFederados, hayResultados, actualizadoTexto } from "../data/competicion";
import type { Grupo } from "../data/competicion";

interface Props {
  full?: boolean;
  /** nombre del grupo de pestañas; compártelo con Calendario para que un
   * mismo selector pilote los dos a la vez. */
  tabGroupName?: string;
  /** oculta el <select> propio, por si ya lo pinta otro componente con el
   * mismo tabGroupName en la misma página. */
  mostrarSelector?: boolean;
  /** equipos a mostrar; por defecto los federados. */
  grupos?: Grupo[];
  /** id de la sección, para poder tener federados y municipales en la misma página. */
  anchorId?: string;
  /** texto bajo el título; por defecto el de la liga federada. */
  intro?: string;
  /** texto del enlace al origen de los datos de cada grupo. */
  enlaceTexto?: string;
  /** pie con la fecha de actualización; por defecto la de la Federación. */
  pie?: string;
}
const {
  full = false,
  tabGroupName = "clasif",
  mostrarSelector = true,
  grupos = gruposFederados,
  anchorId = "clasificacion",
  intro,
  enlaceTexto = "Ficha del grupo en fmvoley.com ↗",
  pie,
} = Astro.props;
---
<div class="section section--crema" id={anchorId}>
  <div class="container">
    <span class="eyebrow">Clasificaciones y resultados</span>
    <h2 class="section-title">La liga, en directo</h2>
    <p class="clasif__intro">
      {intro ?? (
        <>
          Clasificación de los equipos federados de Manzanares Voley, con datos de la
          Federación de Madrid de Voleibol.
          {!hayResultados && " La competición arranca el 27 de septiembre de 2026."}
        </>
      )}
    </p>

    {mostrarSelector && (
      <>
        <label class="cat-select-label" for={`select-${tabGroupName}`}>Elige tu equipo</label>
        <select id={`select-${tabGroupName}`} class="cat-select" data-tabs={tabGroupName} aria-label="Categorías de competición">
          {grupos.map((g, i) => (
            <option value={String(g.grupoId)} selected={i === 0}>{g.categoria}</option>
          ))}
        </select>
      </>
    )}

    {grupos.map((g, i) => (
      <div
        class={`tab-panel${i === 0 ? " active" : ""}`}
        data-tabgroup={tabGroupName}
        data-cat={String(g.grupoId)}
        role="tabpanel"
      >
        <p class="clasif__division">{g.division} · {g.fase}</p>
        {g.clasificacion.length > 0 ? (
          <div class="tabla-wrap">
            <table class="tabla-clasif">
              <thead>
                <tr>
                  <th class="c">#</th>
                  <th>Equipo</th>
                  <th class="c">PJ</th>
                  <th class="c">PG</th>
                  <th class="c">PP</th>
                  <th class="c">Sets</th>
                  <th class="c">Pts</th>
                </tr>
              </thead>
              <tbody>
                {g.clasificacion.map((f) => (
                  <tr class={f.esManzanares ? "is-mzv" : ""}>
                    <td class="c">{f.pos}</td>
                    <td>{f.equipo}</td>
                    <td class="c">{f.pj}</td>
                    <td class="c">{f.pg}</td>
                    <td class="c">{f.pp}</td>
                    <td class="c">{f.setsFavor}-{f.setsContra}</td>
                    <td class="c b">{f.pts}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="match__empty">
            {g.aviso ?? "La clasificación de este equipo se publicará cuando empiece la competición."}
          </p>
        )}
        <a href={g.urlFmvoley} target="_blank" rel="noopener" class="clasif__link">
          {enlaceTexto}
        </a>
      </div>
    ))}

    <p class="clasif__foot">
      {pie ?? `Actualizado automáticamente · ${actualizadoTexto()}`}
      {!full && <> · <a href="/calendario">ver calendario completo →</a></>}
    </p>
  </div>
</div>
