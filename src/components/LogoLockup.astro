---
// Logo oficial del club para web (versión 10º aniversario, sobre fondo oscuro).
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---
<img
  src="/img/logo-web.png"
  alt="Manzanares Voley"
  class={`brand ${className}`.trim()}
  width="593"
  height="595"
/>
