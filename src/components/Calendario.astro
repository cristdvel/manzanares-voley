---
import { grupos as gruposFederados, temporada, fechaCorta, horaCorta } from "../data/competicion";
import type { Grupo } from "../data/competicion";

interface Props {
  /** nombre del grupo de pestañas; compártelo con otro componente (p. ej.
   * Clasificacion) para que un mismo selector pilote los dos a la vez. */
  tabGroupName?: string;
  /** oculta el <select> propio, por si ya lo pinta otro componente con el
   * mismo tabGroupName en la misma página. */
  mostrarSelector?: boolean;
  /** equipos a mostrar; por defecto los federados. */
  grupos?: Grupo[];
  /** id de la sección, para poder tener federados y municipales en la misma página. */
  anchorId?: string;
}
const {
  tabGroupName = "cal",
  mostrarSelector = true,
  grupos = gruposFederados,
  anchorId = "calendario",
} = Astro.props;
---
<div class="section" id={anchorId}>
  <div class="container">
    <span class="eyebrow">Temporada {temporada}</span>
    <h2 class="section-title">Calendario</h2>

    {mostrarSelector && (
      <>
        <label class="cat-select-label" for={`select-${tabGroupName}`}>Elige tu equipo</label>
        <select id={`select-${tabGroupName}`} class="cat-select" data-tabs={tabGroupName} aria-label="Categorías">
          {grupos.map((g, i) => (
            <option value={String(g.grupoId)} selected={i === 0}>{g.categoria}</option>
          ))}
        </select>
      </>
    )}

    {grupos.map((g, i) => (
      <div
        class={`tab-panel${i === 0 ? " active" : ""}`}
        data-tabgroup={tabGroupName}
        data-cat={String(g.grupoId)}
        role="tabpanel"
      >
        <p class="clasif__division">{g.division} · {g.fase}</p>
        {g.misPartidos.length === 0 && g.aviso && <p class="match__empty">{g.aviso}</p>}
        <ol class="cal-list">
          {g.misPartidos.map((p) => (
            <li class={`cal-item${p.jugado ? " is-done" : ""}`}>
              <span class="cal-item__j">J{p.jornada}</span>
              <span class="cal-item__fecha">
                {fechaCorta(p.fechaHora)}
                {horaCorta(p.fechaHora) ? <><br /><small>{horaCorta(p.fechaHora)}</small></> : null}
              </span>
              <span class="cal-item__match">
                <span class={p.esLocal ? "is-mzv" : ""}>{p.local}</span>
                <span class="cal-item__vs">{p.jugado ? p.resultado : "·"}</span>
                <span class={!p.esLocal ? "is-mzv" : ""}>{p.visitante}</span>
              </span>
              {p.aplazado && <span class="cal-item__tag">Aplazado</span>}
              {(p.pabellon || p.fase) && (
                <span class="cal-item__sede">
                  {p.fase && <>{p.fase}{p.pabellon ? " · " : ""}</>}
                  {p.pabellon && <>📍 {p.pabellon}</>}
                  {p.mapa && <> · <a href={p.mapa} target="_blank" rel="noopener">cómo llegar</a></>}
                </span>
              )}
            </li>
          ))}
        </ol>
      </div>
    ))}
  </div>
</div>
