---
import { partidos } from "../data/partidos";
---
<div class="section">
  <div class="container">
    <span class="eyebrow">Temporada 2025 / 2026</span>
    <h2 class="section-title">Próximos partidos</h2>
    <div class="partidos__grid">
      {partidos.map((p) => (
        <article class="match">
          <span class="badge">{p.cat}</span>
          <p class="match__teams">{p.local} <span class="vs">vs</span> {p.visitante}</p>
          <p class="match__meta">{p.fecha}</p>
        </article>
      ))}
    </div>
  </div>
</div>
