---
import { proximos, ultimos, temporada, fechaCorta, horaCorta } from "../data/competicion";
import { amistososVigentes } from "../data/amistosos";
import AmistososTabs from "./AmistososTabs.astro";
import PushSub from "./PushSub.astro";

const PAGINA = 3;
const MAX_PAGINAS = 2;
const visibles = proximos.slice(0, PAGINA * MAX_PAGINAS);
const paginas = Array.from({ length: Math.ceil(visibles.length / PAGINA) }, (_, i) =>
  visibles.slice(i * PAGINA, i * PAGINA + PAGINA),
);
---
<div class="section">
  <div class="container">
    <span class="eyebrow" id="partidos-eyebrow">Temporada {temporada}</span>
    <h2 class="section-title" id="partidos-title">Próximos partidos</h2>

    <div id="vista-proximos">
      {paginas.length > 0 ? (
        <div class="partidos-slider">
          <button
            type="button"
            class="partidos-slider__arrow partidos-slider__arrow--prev"
            id="slider-prev"
            aria-label="Partidos anteriores"
            hidden
          >
            ‹
          </button>

          <div class="partidos-slider__viewport">
            <div class="partidos-slider__track" id="slider-track" style={`--paginas:${paginas.length}`}>
              {paginas.map((pagina) => (
                <div class="partidos-slider__pagina partidos__grid">
                  {pagina.map((p) => (
                    <article class="match">
                      <span class="badge">{p.categoria}</span>
                      <p class="match__teams">
                        <span class={p.esLocal ? "is-mzv" : ""}>{p.local}</span>
                        <span class="vs">vs</span>
                        <span class={!p.esLocal ? "is-mzv" : ""}>{p.visitante}</span>
                      </p>
                      <p class="match__meta">
                        Jornada {p.jornada} · {fechaCorta(p.fechaHora)}{horaCorta(p.fechaHora) ? ` · ${horaCorta(p.fechaHora)}` : ""}
                        {p.pabellon && (
                          <>
                            <br />
                            {p.mapa ? (
                              <a href={p.mapa} target="_blank" rel="noopener">📍 {p.pabellon}</a>
                            ) : (
                              p.pabellon
                            )}
                          </>
                        )}
                      </p>
                    </article>
                  ))}
                </div>
              ))}
            </div>
          </div>

          <button
            type="button"
            class="partidos-slider__arrow partidos-slider__arrow--next"
            id="slider-next"
            aria-label="Más partidos"
            hidden={paginas.length <= 1}
          >
            ›
          </button>

          <a href="/calendario" class="btn btn--outline partidos__ver-mas" id="ver-mas-partidos" hidden>
            Ver más partidos →
          </a>
        </div>
      ) : null}

      {paginas.length > 1 && (
        <div class="partidos-slider__dots" id="slider-dots" role="tablist" aria-label="Página de partidos">
          {paginas.map((_, i) => (
            <span class={`partidos-slider__dot${i === 0 ? " active" : ""}`} data-pagina={i}></span>
          ))}
        </div>
      )}

      {paginas.length === 0 && ultimos.length > 0 && (
        <div class="partidos__grid">
          {ultimos.slice(0, 3).map((p) => (
            <article class="match">
              <span class="badge">{p.categoria}</span>
              <p class="match__teams">
                <span class={p.esLocal ? "is-mzv" : ""}>{p.local}</span>
                <span class="vs">{p.resultado ?? "vs"}</span>
                <span class={!p.esLocal ? "is-mzv" : ""}>{p.visitante}</span>
              </p>
              <p class="match__meta">Jornada {p.jornada} · {fechaCorta(p.fechaHora)}</p>
            </article>
          ))}
        </div>
      )}
    </div>

    {amistososVigentes.length > 0 && (
      <div id="vista-amistosos" hidden>
        <AmistososTabs />
      </div>
    )}

    <div class="partidos__ctas">
      {amistososVigentes.length > 0 && (
        <button type="button" class="btn btn--outline" id="toggle-amistosos" aria-expanded="false">
          🏐 Ver amistosos
        </button>
      )}
      <a href="/calendario" class="btn btn--outline">Ver calendario y clasificación →</a>
      <PushSub />
    </div>
  </div>
</div>

<script>
  // ---- Slider de "Próximos partidos": páginas de 3 en 3 con flechas ----
  const track = document.getElementById("slider-track") as HTMLDivElement | null;
  const prevBtn = document.getElementById("slider-prev") as HTMLButtonElement | null;
  const nextBtn = document.getElementById("slider-next") as HTMLButtonElement | null;
  const dots = Array.from(document.querySelectorAll<HTMLSpanElement>(".partidos-slider__dot"));
  const verMas = document.getElementById("ver-mas-partidos") as HTMLAnchorElement | null;

  if (track) {
    const totalPaginas = Number(track.style.getPropertyValue("--paginas")) || 1;
    let pagina = 0;

    function render() {
      if (!track) return;
      track.style.transform = `translateX(-${pagina * 100}%)`;
      if (prevBtn) prevBtn.hidden = pagina === 0;
      if (nextBtn) nextBtn.hidden = pagina >= totalPaginas - 1;
      if (verMas) verMas.hidden = pagina < totalPaginas - 1;
      dots.forEach((d, i) => d.classList.toggle("active", i === pagina));
    }

    prevBtn?.addEventListener("click", () => {
      pagina = Math.max(0, pagina - 1);
      render();
    });
    nextBtn?.addEventListener("click", () => {
      pagina = Math.min(totalPaginas - 1, pagina + 1);
      render();
    });
    dots.forEach((d, i) => {
      d.addEventListener("click", () => {
        pagina = i;
        render();
      });
    });

    render();
  }

  const toggleBtn = document.getElementById("toggle-amistosos") as HTMLButtonElement | null;
  const eyebrow = document.getElementById("partidos-eyebrow");
  const title = document.getElementById("partidos-title");
  const vistaProximos = document.getElementById("vista-proximos");
  const vistaAmistosos = document.getElementById("vista-amistosos");

  const eyebrowProximos = eyebrow?.textContent ?? "";

  toggleBtn?.addEventListener("click", () => {
    const mostrarAmistosos = vistaProximos!.hidden === false;
    vistaProximos!.hidden = mostrarAmistosos;
    vistaAmistosos!.hidden = !mostrarAmistosos;
    toggleBtn.setAttribute("aria-expanded", String(mostrarAmistosos));
    if (mostrarAmistosos) {
      if (eyebrow) eyebrow.textContent = "Pretemporada";
      if (title) title.textContent = "Amistosos por categoría";
      toggleBtn.textContent = "📅 Ver próximos partidos";
    } else {
      if (eyebrow) eyebrow.textContent = eyebrowProximos;
      if (title) title.textContent = "Próximos partidos";
      toggleBtn.textContent = "🏐 Ver amistosos";
    }
  });
</script>
