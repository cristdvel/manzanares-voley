---
import { categorias, sedes } from "../data/equipos";
import { site } from "../data/site";
---
<div class="section">
  <div class="container">
    <span class="eyebrow">Equipos y competición</span>
    <h2 class="section-title">Nuestros equipos</h2>

    <div class="tabs" role="tablist" aria-label="Categorías">
      {categorias.map((cat, i) => (
        <button
          class={`tab${i === 0 ? " active" : ""}`}
          data-cat={cat.id}
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
        >
          {cat.label}
        </button>
      ))}
    </div>

    {categorias.map((cat, i) => (
      <div class={`tab-panel${i === 0 ? " active" : ""}`} data-cat={cat.id} role="tabpanel">
        {cat.equipos.map((eq) => (
          <article class="team">
            <span class="badge">{cat.label}</span>
            <h3>{eq.nombre}</h3>
            <div class="team__div">{eq.division}</div>
            <p class="team__meta">{eq.meta}</p>
          </article>
        ))}
      </div>
    ))}
  </div>
</div>

<!-- Clasificaciones -->
<div class="section section--crema">
  <div class="container">
    <div class="clasif">
      <h2 class="section-title">Clasificaciones y resultados</h2>
      <p>Nuestros equipos federados compiten en la Federación de Madrid de Voleibol. Elige competición y grupo en el buscador para ver la clasificación y los resultados en directo.</p>
      <a href={site.fmvb} target="_blank" rel="noopener" class="btn btn--outline">Abrir en fmvoley.com ↗</a>
    </div>
    <div class="clasif-embed">
      <iframe
        title="Clasificaciones y resultados — Federación de Madrid de Voleibol"
        src={site.fmvb}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</div>

<!-- Sedes -->
<div class="section">
  <div class="container">
    <span class="eyebrow">Sedes</span>
    <h2 class="section-title">Dónde entrenamos</h2>
    <div class="sedes">
      <div class="mapa">
        <iframe
          title="Ubicación del Club Voleibol Manzanares"
          src="https://www.google.com/maps?q=Calle%20Duquesa%20de%20Parcet%20116%2C%2028047%20Madrid&z=14&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
      <ul class="sede-list">
        {sedes.map((s) => (
          <li>📍 {s.nombre} <span>{s.nota}</span></li>
        ))}
      </ul>
    </div>
  </div>
</div>
