---
import { categorias, sedes, fotosEquipos } from "../data/equipos";
import Clasificacion from "./Clasificacion.astro";
---
<div class="section">
  <div class="container">
    <span class="eyebrow">Equipos y competición</span>
    <h2 class="section-title">Nuestros equipos</h2>

    <div class="tabs" data-tabs="equipos" role="tablist" aria-label="Categorías">
      {categorias.map((cat, i) => (
        <button
          class={`tab${i === 0 ? " active" : ""}`}
          data-cat={cat.id}
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
        >
          {cat.label}
        </button>
      ))}
    </div>

    {categorias.map((cat, i) => (
      <div
        class={`tab-panel${i === 0 ? " active" : ""}`}
        data-tabgroup="equipos"
        data-cat={cat.id}
        role="tabpanel"
      >
        {cat.equipos.map((eq) => (
          <article class="team">
            <span class="badge">{cat.label}</span>
            <h3>{eq.nombre}</h3>
            <div class="team__div">{eq.division}</div>
            {cat.id.startsWith("federado") && (
              eq.calendario ? (
                <p class="team__cal team__cal--ok">✓ Calendario y clasificación disponibles</p>
              ) : (
                <p class="team__cal">Calendario pendiente de publicar por la Federación</p>
              )
            )}
          </article>
        ))}
      </div>
    ))}
  </div>
</div>

<!-- Fotos reales de la temporada -->
<div class="section section--crema">
  <div class="container">
    <span class="eyebrow">Esta temporada</span>
    <h2 class="section-title">Nuestros equipos en el pabellón</h2>
    <div class="team-photos">
      {fotosEquipos.map((f) => (
        <figure class="team-photo">
          <button
            type="button"
            class="team-photo__btn"
            data-lightbox={f.foto}
            data-caption={`${f.equipo} · ${f.categoria}`}
            aria-label={`Ampliar foto: ${f.equipo} · ${f.categoria}`}
          >
            <img src={f.foto} alt={`Equipo ${f.equipo} · ${f.categoria}`} loading="lazy" width="600" height="600" />
          </button>
          <figcaption><strong>{f.equipo}</strong><span>{f.categoria}</span></figcaption>
        </figure>
      ))}
    </div>

    <div id="team-lightbox" class="lightbox" hidden>
      <button type="button" class="lightbox__close" data-lightbox-close aria-label="Cerrar">✕</button>
      <img id="team-lightbox-img" src="" alt="" />
      <p id="team-lightbox-cap" class="lightbox__cap"></p>
    </div>
  </div>
</div>

<script>
  const lb = document.getElementById("team-lightbox") as HTMLDivElement | null;
  const lbImg = document.getElementById("team-lightbox-img") as HTMLImageElement | null;
  const lbCap = document.getElementById("team-lightbox-cap") as HTMLParagraphElement | null;

  function abrir(src: string, caption: string) {
    if (!lb || !lbImg || !lbCap) return;
    lbImg.src = src;
    lbImg.alt = caption;
    lbCap.textContent = caption;
    lb.hidden = false;
    document.body.style.overflow = "hidden";
  }
  function cerrar() {
    if (!lb || !lbImg) return;
    lb.hidden = true;
    lbImg.src = "";
    document.body.style.overflow = "";
  }

  document.querySelectorAll<HTMLButtonElement>("[data-lightbox]").forEach((btn) => {
    btn.addEventListener("click", () => abrir(btn.dataset.lightbox!, btn.dataset.caption || ""));
  });
  document.querySelector("[data-lightbox-close]")?.addEventListener("click", cerrar);
  lb?.addEventListener("click", (e) => {
    if (e.target === lb) cerrar();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && lb && !lb.hidden) cerrar();
  });
</script>

<!-- Clasificación en directo (datos de la FMVoley) -->
<Clasificacion />

<!-- Sedes -->
<div class="section">
  <div class="container">
    <span class="eyebrow">Sedes</span>
    <h2 class="section-title">Dónde entrenamos</h2>
    <div class="sedes">
      <div
        class="mapa embed-gate"
        data-embed-src="https://www.google.com/maps?q=Colegio%20Nueva%20Castilla%2C%20Calle%20Mazater%C3%B3n%2012%2C%2028051%20Madrid&z=14&output=embed"
        data-embed-title="Ubicación del Club Voleibol Manzanares"
      >
        <div class="embed-gate__msg">
          <p>El mapa se carga desde Google Maps, que instala cookies.</p>
          <button type="button" class="btn btn--outline" data-embed-load>Cargar el mapa</button>
        </div>
      </div>
      <ul class="sede-list">
        {sedes.map((s) => (
          <li>📍 {s.nombre} <span>{s.nota}</span></li>
        ))}
      </ul>
    </div>
  </div>
</div>
