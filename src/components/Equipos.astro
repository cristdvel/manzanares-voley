---
import { categorias, sedes } from "../data/equipos";
import Clasificacion from "./Clasificacion.astro";
---
<div class="section">
  <div class="container">
    <span class="eyebrow">Equipos y competición</span>
    <h2 class="section-title">Nuestros equipos</h2>

    <div class="tabs" data-tabs="equipos" role="tablist" aria-label="Categorías">
      {categorias.map((cat, i) => (
        <button
          class={`tab${i === 0 ? " active" : ""}`}
          data-cat={cat.id}
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
        >
          {cat.label}
        </button>
      ))}
    </div>

    {categorias.map((cat, i) => (
      <div
        class={`tab-panel${i === 0 ? " active" : ""}`}
        data-tabgroup="equipos"
        data-cat={cat.id}
        role="tabpanel"
      >
        {cat.equipos.map((eq) => (
          <article class="team">
            <span class="badge">{cat.label}</span>
            <h3>{eq.nombre}</h3>
            <div class="team__div">{eq.division}</div>
            <p class="team__meta">{eq.meta}</p>
          </article>
        ))}
      </div>
    ))}
  </div>
</div>

<!-- Clasificación en directo (datos de la FMVoley) -->
<Clasificacion />

<!-- Sedes -->
<div class="section">
  <div class="container">
    <span class="eyebrow">Sedes</span>
    <h2 class="section-title">Dónde entrenamos</h2>
    <div class="sedes">
      <div class="mapa">
        <iframe
          title="Ubicación del Club Voleibol Manzanares"
          src="https://www.google.com/maps?q=Colegio%20Nueva%20Castilla%2C%20Calle%20Mazater%C3%B3n%2012%2C%2028051%20Madrid&z=14&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
      <ul class="sede-list">
        {sedes.map((s) => (
          <li>📍 {s.nombre} <span>{s.nota}</span></li>
        ))}
      </ul>
    </div>
  </div>
</div>
