---
import { categorias, sedes } from "../data/equipos";
import { site } from "../data/site";
---
<div class="section">
  <div class="container">
    <span class="eyebrow">Equipos y competición</span>
    <h2 class="section-title">Nuestros equipos</h2>

    <div class="tabs" role="tablist" aria-label="Categorías">
      {categorias.map((cat, i) => (
        <button
          class={`tab${i === 0 ? " active" : ""}`}
          data-cat={cat.id}
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
        >
          {cat.label}
        </button>
      ))}
    </div>

    {categorias.map((cat, i) => (
      <div class={`tab-panel${i === 0 ? " active" : ""}`} data-cat={cat.id} role="tabpanel">
        {cat.equipos.map((eq) => (
          <article class="team">
            <span class="badge">{cat.label}</span>
            <h3>{eq.nombre}</h3>
            <div class="team__div">{eq.division}</div>
            <p class="team__meta">{eq.meta}</p>
          </article>
        ))}
      </div>
    ))}
  </div>
</div>

<!-- Clasificaciones -->
<div class="section section--crema">
  <div class="container clasif">
    <h2 class="section-title">Clasificaciones y resultados</h2>
    <p>Todos nuestros equipos federados compiten en la Federación de Madrid de Voleibol. Consulta calendarios, resultados y clasificaciones actualizados en su web oficial.</p>
    <a href={site.fmvb} target="_blank" rel="noopener" class="btn btn--primary btn--lg">Ver clasificaciones en la FMVoley →</a>
  </div>
</div>

<!-- Sedes -->
<div class="section">
  <div class="container">
    <span class="eyebrow">Sedes</span>
    <h2 class="section-title">Dónde entrenamos</h2>
    <div class="sedes">
      <div class="mapa">
        <iframe
          title="Ubicación del Pabellón Tomás Bretón"
          src="https://www.google.com/maps?q=Pabell%C3%B3n%20Deportivo%20Tom%C3%A1s%20Bret%C3%B3n%2C%20Madrid&z=14&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
      <ul class="sede-list">
        {sedes.map((s) => (
          <li>📍 {s.nombre} <span>{s.nota}</span></li>
        ))}
      </ul>
    </div>
  </div>
</div>
