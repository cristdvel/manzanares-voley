---
import { nav, site } from "../data/site";
import LogoLockup from "./LogoLockup.astro";
---
<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <LogoLockup variant="stacked" class="brand--footer" />
        <p>Pasión por el voleibol desde 2016.</p>
      </div>

      <div>
        <h4>Navegación</h4>
        <ul>
          {nav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4>Contacto</h4>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={`tel:+34${site.telefono.replace(/\s/g, "")}`}>{site.telefono}</a></li>
          <li>{site.ciudad}</li>
        </ul>
      </div>

      <div>
        <h4>Síguenos</h4>
        <div class="socials">
          <a href={site.social.instagram} aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg>
          </a>
          <a href={site.social.facebook} aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h3l.5-3H14V4.5c0-.9.3-1.5 1.6-1.5H17V.3C16.6.2 15.6 0 14.5 0 12 0 10.3 1.5 10.3 4.3V6H7.5v3h2.8v9H14z" /></svg>
          </a>
          <a href={site.social.youtube} aria-label="YouTube">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.2-.4-4.7c-.2-.9-.9-1.5-1.8-1.8C19.3 5 12 5 12 5s-7.3 0-8.8.5c-.9.3-1.6.9-1.8 1.8C1 8.8 1 12 1 12s0 3.2.4 4.7c.2.9.9 1.5 1.8 1.8C4.7 19 12 19 12 19s7.3 0 8.8-.5c.9-.3 1.6-.9 1.8-1.8.4-1.5.4-4.7.4-4.7zM9.8 15V9l5.2 3z" /></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      © 2026 Club Voleibol Manzanares · manzanaresvoley.com · <a href="#">Política de privacidad</a>
    </div>
  </div>
</footer>
