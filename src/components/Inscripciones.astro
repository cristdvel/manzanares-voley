---
import { faqs } from "../data/faqs";
---
<div class="insc-hero">
  <div class="container">
    <h2>Únete a Manzanares Voley</h2>
    <p>Tenemos equipos para todas las edades, desde los 9 años hasta adultos.</p>
  </div>
</div>

<div class="section" style="padding-top:0">
  <div class="container">
    <div class="form-wrap">
      <form id="insc-form" novalidate>
        <div class="field">
          <label for="nombre">Nombre de la jugadora / jugador <span class="req">*</span></label>
          <input type="text" id="nombre" name="nombre" required autocomplete="name" />
          <span class="error-msg">Indica el nombre del deportista.</span>
        </div>

        <div class="field">
          <label for="dob">Fecha de nacimiento <span class="req">*</span></label>
          <input type="date" id="dob" name="dob" required />
          <span class="error-msg">Indica la fecha de nacimiento.</span>
          <span class="cat-hint" id="cat-hint"></span>
        </div>

        <div class="field">
          <label for="tutor">Nombre del padre / madre / tutor <span class="req">*</span></label>
          <input type="text" id="tutor" name="tutor" required />
          <span class="error-msg">Indica el nombre del tutor.</span>
        </div>

        <div class="field">
          <label for="tel">Teléfono de contacto <span class="req">*</span></label>
          <input type="tel" id="tel" name="tel" required autocomplete="tel" />
          <span class="error-msg">Indica un teléfono de contacto.</span>
        </div>

        <div class="field">
          <label for="email">Email <span class="req">*</span></label>
          <input type="email" id="email" name="email" required autocomplete="email" />
          <span class="error-msg">Indica un email válido.</span>
        </div>

        <div class="field">
          <label for="exp">Experiencia previa</label>
          <select id="exp" name="exp">
            <option value="sin">Sin experiencia</option>
            <option value="1-2">1–2 años</option>
            <option value="3+">Más de 3 años</option>
          </select>
        </div>

        <label class="check" for="privacidad">
          <input type="checkbox" id="privacidad" name="privacidad" required />
          <span>He leído y acepto la <a href="/privacidad" target="_blank" rel="noopener">política de privacidad</a> y el tratamiento de datos para la gestión de la inscripción. <span class="req">*</span></span>
        </label>

        <label class="check" for="imagenes">
          <input type="checkbox" id="imagenes" name="imagenes" />
          <span>Autorizo el uso de imágenes del deportista para la comunicación del club (redes sociales, web).</span>
        </label>

        <button type="submit" class="btn btn--primary btn--lg">Enviar inscripción</button>
        <p class="form-note">Nos pondremos en contacto contigo en menos de 48 horas para confirmar la prueba.</p>
      </form>

      <div class="form-success" id="form-success" role="status">
        <strong>¡Inscripción recibida!</strong><br />
        Gracias por confiar en Manzanares Voley. Nos pondremos en contacto contigo en menos de 48 horas para concretar la sesión de prueba.
      </div>
    </div>
  </div>
</div>

<!-- FAQ -->
<div class="section section--crema">
  <div class="container">
    <span class="eyebrow">Antes de apuntarte</span>
    <h2 class="section-title">Preguntas frecuentes</h2>
    <div class="faq">
      {faqs.map((f) => (
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">
            <span>{f.q}</span><span class="ico" aria-hidden="true">+</span>
          </button>
          <div class="faq-a"><div><p>{f.a}</p></div></div>
        </div>
      ))}
    </div>
  </div>
</div>
