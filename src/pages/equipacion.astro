---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { juego, entreno, sudadera, accesorios } from "../data/equipacion";
import { site } from "../data/site";

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: site.url },
    { "@type": "ListItem", position: 2, name: "Equipación oficial", item: site.url + "equipacion/" },
  ],
};
---

<Base
  title="Equipación oficial · 10º aniversario | Manzanares Voley"
  description="Colección conmemorativa del 10º aniversario del Club Voleibol Manzanares: camisetas de juego «Gatos» y «Claveles», ropa de entreno, sudadera y accesorios."
  schemas={[breadcrumb]}
>
  <Header />
  <main id="contenido">
    <div class="page-hero">
      <div class="container">
        <span class="eyebrow">Tienda oficial</span>
        <h1>Equipación oficial · 10º aniversario</h1>
        <p>La colección conmemorativa de una década de Manzanares Voley: dos diseños de camiseta de juego, ropa de entreno, la sudadera del aniversario y los accesorios del club.</p>
      </div>
    </div>

    <!-- Equipación de juego -->
    <section class="section">
      <div class="container">
        <span class="eyebrow">Equipación de juego</span>
        <h2 class="section-title">Dos diseños del aniversario</h2>
        {juego.map((j) => (
          <div class="kit-feature">
            <div class="kit-feature__info">
              <h3>{j.nombre}</h3>
              <p>{j.desc}</p>
            </div>
            <div class="kit-shots">
              <figure class="kit-shot"><img src={j.camiseta.frente} alt={`${j.nombre} — camiseta frente`} loading="lazy" /><figcaption>Camiseta · frente</figcaption></figure>
              <figure class="kit-shot"><img src={j.camiseta.espalda} alt={`${j.nombre} — camiseta espalda`} loading="lazy" /><figcaption>Camiseta · espalda</figcaption></figure>
              <figure class="kit-shot"><img src={j.malla} alt={`${j.nombre} — malla`} loading="lazy" /><figcaption>Malla</figcaption></figure>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Ropa de entreno -->
    <section class="section section--crema">
      <div class="container">
        <span class="eyebrow">Día a día</span>
        <h2 class="section-title">Ropa de entreno</h2>
        <div class="kit-grid">
          {entreno.map((e) => (
            <figure class="kit-card"><img src={e.img} alt={e.nombre} loading="lazy" /><figcaption>{e.nombre}</figcaption></figure>
          ))}
        </div>
      </div>
    </section>

    <!-- Sudadera 10º aniversario -->
    <section class="section">
      <div class="container">
        <span class="eyebrow">Pieza estrella</span>
        <h2 class="section-title">Sudadera 10º aniversario</h2>
        <div class="kit-grid">
          <figure class="kit-card"><img src={sudadera.frente} alt="Sudadera 10º aniversario — frente" loading="lazy" /><figcaption>Frente</figcaption></figure>
          <figure class="kit-card"><img src={sudadera.espalda} alt="Sudadera 10º aniversario — espalda" loading="lazy" /><figcaption>Espalda · huellas y «10 aniversario»</figcaption></figure>
        </div>
      </div>
    </section>

    <!-- Accesorios -->
    <section class="section section--crema">
      <div class="container">
        <span class="eyebrow">Complementos</span>
        <h2 class="section-title">Abrigo y mochila</h2>
        <div class="kit-grid">
          {accesorios.map((a) => (
            <figure class="kit-card"><img src={a.img} alt={a.nombre} loading="lazy" /><figcaption>{a.nombre}</figcaption></figure>
          ))}
        </div>
      </div>
    </section>

    <!-- Contacto -->
    <section class="section section--oscuro">
      <div class="container center">
        <h2 class="section-title">¿Quieres una pieza?</h2>
        <p class="section-intro">Los pedidos, las tallas y los precios se gestionan directamente con el club. Escríbenos y te contamos disponibilidad y plazos.</p>
        <div class="page-cta">
          <a href={`mailto:${site.email}?subject=Equipaci%C3%B3n%2010%C2%BA%20aniversario`} class="btn btn--primary btn--lg">Escribir al club</a>
          <a href="/#inscripciones" class="btn btn--outline-light btn--lg">Volver a la web</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
