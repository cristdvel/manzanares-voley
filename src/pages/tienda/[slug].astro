---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { productos, getRelacionados, type Producto } from "../../data/productos";
import { site } from "../../data/site";

export function getStaticPaths() {
  return productos.map((p) => ({ params: { slug: p.id }, props: { producto: p } }));
}

interface Props {
  producto: Producto;
}
const { producto: p } = Astro.props;
const relacionados = getRelacionados(p);
const url = site.url + "tienda/" + p.id + "/";
const esPack = !!p.incluye?.length;
const tallasPack = p.tallasPack ?? [];

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: p.nombre,
  category: p.categoria,
  image: p.imagenes.map((i) => new URL(i.src, site.url).href),
  description: p.descripcion,
  brand: { "@type": "Brand", name: "Manzanares Voley" },
  offers: {
    "@type": "Offer",
    price: String(p.precio),
    priceCurrency: "EUR",
    availability: p.disponible
      ? "https://schema.org/InStock"
      : "https://schema.org/OutOfStock",
    url,
  },
};
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: site.url },
    { "@type": "ListItem", position: 2, name: "Tienda", item: site.url + "tienda/" },
    { "@type": "ListItem", position: 3, name: p.nombre, item: url },
  ],
};
---

<Base
  title={`${p.nombre} | Tienda Manzanares Voley`}
  description={p.resumen}
  image={p.imagenes[0].src}
  schemas={[productSchema, breadcrumb]}
>
  <Header />
  <main id="contenido">
    <div class="pdp-wrap section">
      <div class="container">
        <nav class="crumbs" aria-label="Migas de pan">
          <a href="/tienda">Tienda</a> <span aria-hidden="true">/</span>
          <span>{p.categoria}</span>
        </nav>

        <div class="pdp">
          <div class="pdp__gallery">
            <div class="pdp__main">
              <img id="pdp-main" src={p.imagenes[0].src} alt={p.nombre} width="600" height="600" />
            </div>
            {p.imagenes.length > 1 && (
              <div class="pdp__thumbs">
                {p.imagenes.map((img, i) => (
                  <button
                    type="button"
                    class={`pdp__thumb${i === 0 ? " is-on" : ""}`}
                    data-src={img.src}
                    data-variante={img.variante}
                    aria-label={`Imagen ${i + 1}`}
                  >
                    <img src={img.src} alt="" loading="lazy" />
                  </button>
                ))}
              </div>
            )}
          </div>

          <div class="pdp__summary">
            <h1>{p.nombre}</h1>
            <p class="pdp__cat">{p.categoria}</p>
            <p class="pdp__price">{p.precio === 0 ? "Por confirmar" : `${p.precio} €`}
              {(p.precioNota || p.precio === 0) && (
                <span class="pdp__price-note">
                  {p.precioNota ?? "provisional · el club te confirma el importe"}
                </span>
              )}
            </p>
            <p class="pdp__resumen">{p.resumen}</p>

            {esPack && (
              <div class="pdp__incluye">
                <h2>Qué incluye el pack</h2>
                <ul>
                  {p.incluye!.map((i) => <li>{i}</li>)}
                </ul>
              </div>
            )}

            <form id="pedido-form" class="pdp__form" data-producto={p.nombre} data-precio={p.precio} novalidate>
              <div class="pdp__opts">
                {p.variantes.map((v) => (
                  <label>
                    <span class="pdp__opt-lbl">{v.nombre} <span class="req">*</span></span>
                    <select data-opt={v.nombre} required>
                      <option value="">Elige…</option>
                      {v.opciones.map((o) => <option value={o}>{o}</option>)}
                    </select>
                  </label>
                ))}
                {tallasPack.length > 0 ? (
                  tallasPack.map((g) =>
                    g.corte ? (
                      <div class="pdp__corte-group" data-corte-group>
                        <label>
                          <span class="pdp__opt-lbl">Corte — {g.nombre.replace(/^Talla\s*/i, "")} <span class="req">*</span></span>
                          <select data-opt={`Corte ${g.nombre}`} data-corte-select required>
                            <option value="">Elige…</option>
                            <option value="Chica">Chica</option>
                            <option value="Chico">Chico</option>
                          </select>
                        </label>
                        <label>
                          <span class="pdp__opt-lbl">{g.nombre} <span class="req">*</span></span>
                          <select
                            data-opt={g.nombre}
                            data-tallas-chica={JSON.stringify(g.corte.chica)}
                            data-tallas-chico={JSON.stringify(g.corte.chico)}
                            data-talla-select
                            required
                            disabled
                          >
                            <option value="">Elige el corte primero…</option>
                          </select>
                        </label>
                      </div>
                    ) : (
                      <label>
                        <span class="pdp__opt-lbl">{g.nombre} <span class="req">*</span></span>
                        <select data-opt={g.nombre} required>
                          <option value="">Elige…</option>
                          {g.tallas!.map((t) => <option value={t}>{t}</option>)}
                        </select>
                      </label>
                    ),
                  )
                ) : p.corte ? (
                  <div class="pdp__corte-group" data-corte-group>
                    <label>
                      <span class="pdp__opt-lbl">Corte <span class="req">*</span></span>
                      <select data-opt="Corte" data-corte-select required>
                        <option value="">Elige…</option>
                        <option value="Chica">Chica</option>
                        <option value="Chico">Chico</option>
                      </select>
                    </label>
                    <label>
                      <span class="pdp__opt-lbl">Talla <span class="req">*</span></span>
                      <select
                        data-opt="talla"
                        data-prenda={p.prenda ?? "Talla"}
                        data-tallas-chica={JSON.stringify(p.corte.chica)}
                        data-tallas-chico={JSON.stringify(p.corte.chico)}
                        data-talla-select
                        required
                        disabled
                      >
                        <option value="">Elige el corte primero…</option>
                      </select>
                    </label>
                  </div>
                ) : (
                  <label>
                    <span class="pdp__opt-lbl">Talla <span class="req">*</span></span>
                    <select data-opt="talla" data-prenda={p.prenda ?? "Talla"} required>
                      {(p.tallas?.length ?? 0) > 1 && <option value="">Elige…</option>}
                      {p.tallas?.map((t) => <option value={t}>{t}</option>)}
                    </select>
                  </label>
                )}
                <label class="pdp__qty">
                  <span class="pdp__opt-lbl">Unidades</span>
                  <input type="number" data-opt="cantidad" min="1" max="20" value="1" />
                </label>
              </div>

              <hr class="pdp__sep" />

              <div class="field">
                <label for="p-nombre">Nombre y apellidos <span class="req">*</span></label>
                <input type="text" id="p-nombre" name="nombre" required autocomplete="name" />
              </div>
              <div class="field">
                <label for="p-email">Email <span class="req">*</span></label>
                <input type="email" id="p-email" name="email" required autocomplete="email" />
              </div>
              <div class="field">
                <label for="p-tel">Teléfono <span class="req">*</span></label>
                <input type="tel" id="p-tel" name="telefono" required autocomplete="tel" />
              </div>
              <div class="field">
                <label for="p-equipo">Equipo <span class="req">*</span></label>
                <input type="text" id="p-equipo" name="equipo" required placeholder="Ej. Cadete A Femenino" />
              </div>
              <div class="field">
                <label for="p-notas">Notas</label>
                <textarea id="p-notas" name="notas" rows="2" placeholder="Nombre y dorsal para la camiseta de juego…"></textarea>
                <span class="field-hint">
                  Si quieres nombre y dorsal en la camiseta de juego, escríbelos aquí (p. ej. "GARCÍA · 7").
                  Si lo dejas en blanco, se entrega sin personalizar.
                </span>
              </div>
              <div class="field" id="field-file">
                <label for="p-file">Comprobante de pago <span class="req">*</span></label>
                <input type="file" id="p-file" name="comprobante" accept="image/*,application/pdf" required />
                <div class="transfer-info">
                  Realiza la transferencia a:
                  <strong>ES24 2100 4888 7322 0013 6834</strong>
                  A nombre de: Club Deportivo Elemental Manzanares Voley
                </div>
                <span class="error-msg">Es obligatorio adjuntar el justificante de la transferencia (imagen o PDF, máx. 8 MB).</span>
              </div>

              <label class="check" for="p-priv">
                <input type="checkbox" id="p-priv" required />
                <span>He leído y acepto la <a href="/privacidad" target="_blank" rel="noopener">política de privacidad</a>. <span class="req">*</span></span>
              </label>

              <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />

              <button type="submit" class="btn btn--primary btn--lg" id="pedido-submit">Realizar pedido</button>
              <p class="form-note">Recibimos tu pedido por email y te contestamos en menos de 48 h para cerrar la entrega.</p>
            </form>

            <div id="pedido-error" class="pedido-error" role="alert" hidden></div>
          </div>
        </div>

        <div class="pdp__info">
          <div>
            <h2 class="section-title">Descripción</h2>
            <p>{p.descripcion}</p>
          </div>
          <div>
            <h2 class="section-title">Características</h2>
            <ul class="pdp__feats">
              {p.caracteristicas.map((c) => <li>{c}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>

    {relacionados.length > 0 && (
      <section class="section section--crema">
        <div class="container">
          <span class="eyebrow">También te puede servir</span>
          <h2 class="section-title">Artículos relacionados</h2>
          <div class="shop__grid">
            {relacionados.map((r) => (
              <a class="card-prod" href={`/tienda/${r.id}`}>
                <div class="card-prod__img">
                  <img src={r.imagenes[0].src} alt={r.nombre} loading="lazy" />
                </div>
                <div class="card-prod__body">
                  <h3>{r.nombre}</h3>
                  <p class="card-prod__resumen">{r.resumen}</p>
                  <span class="card-prod__cta">Ver artículo →</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
  <Footer />
</Base>

<script>
  // Galería
  const main = document.getElementById("pdp-main") as HTMLImageElement | null;
  const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>(".pdp__thumb"));

  function mostrar(btn: HTMLButtonElement | undefined) {
    if (!btn || !main) return;
    main.src = btn.dataset.src || main.src;
    thumbs.forEach((t) => t.classList.toggle("is-on", t === btn));
  }
  thumbs.forEach((btn) => btn.addEventListener("click", () => mostrar(btn)));

  // Al elegir modelo/variante: deja visibles sólo las fotos de ese modelo
  // (frente y espalda) y pon la de frente como principal.
  const esTallaKey = (k: string) => k === "talla" || /^talla/i.test(k);
  const varSelects = Array.from(
    document.querySelectorAll<HTMLSelectElement>(".pdp__opts select[data-opt]"),
  ).filter((s) => {
    const k = s.dataset.opt || "";
    return k !== "cantidad" && !esTallaKey(k) && !s.hasAttribute("data-corte-select");
  });

  function filtrarPorVariante(v: string) {
    let primera: HTMLButtonElement | undefined;
    thumbs.forEach((t) => {
      const suya = !v || !t.dataset.variante || t.dataset.variante === v;
      t.hidden = !suya;
      if (suya && !primera) primera = t;
    });
    mostrar(primera);
  }

  varSelects.forEach((sel) => {
    sel.addEventListener("change", () => {
      if (sel.value) filtrarPorVariante(sel.value);
    });
  });

  // Corte dependiente (chica/chico): la lista de tallas cambia según el
  // corte elegido, en vez de mostrar una única tabla de tallas para todos.
  document.querySelectorAll<HTMLElement>("[data-corte-group]").forEach((group) => {
    const corteSel = group.querySelector<HTMLSelectElement>("[data-corte-select]");
    const tallaSel = group.querySelector<HTMLSelectElement>("[data-talla-select]");
    if (!corteSel || !tallaSel) return;
    const tallasChica: string[] = JSON.parse(tallaSel.dataset.tallasChica || "[]");
    const tallasChico: string[] = JSON.parse(tallaSel.dataset.tallasChico || "[]");
    corteSel.addEventListener("change", () => {
      const lista = corteSel.value === "Chica" ? tallasChica : corteSel.value === "Chico" ? tallasChico : [];
      tallaSel.innerHTML = "";
      if (!lista.length) {
        tallaSel.disabled = true;
        tallaSel.appendChild(new Option("Elige el corte primero…", ""));
        return;
      }
      tallaSel.disabled = false;
      tallaSel.appendChild(new Option("Elige…", ""));
      lista.forEach((t) => tallaSel.appendChild(new Option(t, t)));
    });
  });

  // Pedido
  const form = document.getElementById("pedido-form") as HTMLFormElement | null;
  const errEl = document.getElementById("pedido-error")!;
  const submitBtn = document.getElementById("pedido-submit") as HTMLButtonElement;
  const fileEl = document.getElementById("p-file") as HTMLInputElement;
  const fieldFile = document.getElementById("field-file")!;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errEl.hidden = true;

    // opciones de producto
    const opts: Record<string, string> = {};
    let faltaOpt = false;
    form.querySelectorAll<HTMLSelectElement | HTMLInputElement>("[data-opt]").forEach((el) => {
      const k = (el as HTMLElement).dataset.opt!;
      const v = el.value.trim();
      opts[k] = v;
      if (k !== "cantidad" && !v) {
        faltaOpt = true;
        el.classList.add("prod__opt--err");
      } else {
        el.classList.remove("prod__opt--err");
      }
    });

    // archivo OBLIGATORIO
    const f = fileEl.files && fileEl.files[0];
    const fileMal = !f || f.size === 0 || f.size > 8 * 1024 * 1024;
    fieldFile.classList.toggle("field--error", !!fileMal);

    if (faltaOpt || fileMal || !form.checkValidity()) {
      if (!faltaOpt && !fileMal) form.reportValidity();
      return;
    }

    const keys = Object.keys(opts).filter((k) => k !== "cantidad");
    const variante = keys
      .filter((k) => !esTallaKey(k))
      .map((k) => opts[k])
      .join(" · ");

    // tallas por prenda, p. ej. { "Camiseta de juego": "L", "Camiseta de entreno": "M" },
    // para que el pedido llegue desglosado en columnas separadas al excel de
    // pedidos (cada prenda cae en su propia columna, nunca en una "Talla" genérica).
    const tallaKeys = keys.filter(esTallaKey);
    const tallas: Record<string, string> = {};
    tallaKeys.forEach((k) => {
      let etiqueta: string;
      if (k === "talla") {
        const sel = form.querySelector('[data-opt="talla"]') as HTMLElement | null;
        etiqueta = sel?.dataset.prenda || "Talla";
      } else {
        const et = k.replace(/^talla\s*/i, "");
        etiqueta = et ? et[0].toUpperCase() + et.slice(1) : "Talla";
      }
      tallas[etiqueta] = opts[k];
    });
    const talla =
      tallaKeys.length === 1 && tallaKeys[0] === "talla"
        ? opts["talla"]
        : Object.entries(tallas)
            .map(([k, v]) => `${k}: ${v}`)
            .join(" · ");

    const linea = {
      nombre: form.dataset.producto,
      variante,
      talla,
      tallas,
      cantidad: Math.max(1, Math.min(20, parseInt(opts.cantidad || "1", 10))),
    };

    const fd = new FormData(form);
    fd.append("pedido", JSON.stringify([linea]));

    submitBtn.disabled = true;
    submitBtn.textContent = "Enviando…";
    try {
      const res = await fetch("/api/pedido", { method: "POST", body: fd });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.ok) {
        (window as any).dataLayer = (window as any).dataLayer || [];
        (window as any).dataLayer.push({
          event: "pedido_realizado",
          numero_pedido: data.numero,
          producto: form.dataset.producto,
          valor: Number(form.dataset.precio || "0") * linea.cantidad,
        });

        const params = new URLSearchParams({
          pedido: data.numero || "",
          producto: (form.dataset.producto as string) || "",
        });
        window.location.href = "/tienda/gracias?" + params.toString();
        return;
      } else {
        throw new Error(data.error || "No se pudo enviar el pedido.");
      }
    } catch (err) {
      errEl.textContent = (err as Error).message + " Si sigue fallando, escríbenos por email.";
      errEl.hidden = false;
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Realizar pedido";
    }
  });
</script>
