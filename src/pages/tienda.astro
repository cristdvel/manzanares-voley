---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { productos, categoriasTienda } from "../data/productos";
import { site } from "../data/site";

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: site.url },
    { "@type": "ListItem", position: 2, name: "Tienda oficial", item: site.url + "tienda/" },
  ],
};
const productSchemas = productos.map((p) => ({
  "@context": "https://schema.org",
  "@type": "Product",
  name: p.nombre,
  category: p.categoria,
  image: new URL(p.imagenes[0], site.url).href,
  description: p.descripcion,
  brand: { "@type": "Brand", name: "Manzanares Voley" },
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "EUR",
    availability: p.disponible
      ? "https://schema.org/InStock"
      : "https://schema.org/OutOfStock",
    url: site.url + "tienda/",
  },
}));
---

<Base
  title="Tienda oficial | Manzanares Voley"
  description="Equipación y material oficial del Club Voleibol Manzanares. Haz tu pedido online y adjunta el comprobante de pago."
  schemas={[breadcrumb, ...productSchemas]}
>
  <Header />
  <main id="contenido">
    <div class="page-hero">
      <div class="container">
        <span class="eyebrow">Tienda</span>
        <h1>Tienda oficial</h1>
        <p>
          Equipación y material del club. Elige talla y variante, añade lo que quieras al
          pedido y adjunta el comprobante de la transferencia al tramitarlo. Recibirás
          confirmación por email y la recogida es en el pabellón.
        </p>
      </div>
    </div>

    <section class="section shop">
      <div class="container">
        {categoriasTienda.map((cat) => (
          <div class="shop__cat">
            <h2 class="section-title">{cat}</h2>
            <div class="shop__grid">
              {productos
                .filter((p) => p.categoria === cat)
                .map((p) => (
                  <article class="prod" data-prod={p.id} data-nombre={p.nombre}>
                    <div class="prod__media">
                      {p.imagenes.map((img, i) => (
                        <img
                          src={img}
                          alt={`${p.nombre}${p.imagenes.length > 1 ? ` (${i + 1})` : ""}`}
                          loading="lazy"
                          hidden={i !== 0}
                          data-shot={i}
                        />
                      ))}
                      {p.imagenes.length > 1 && (
                        <div class="prod__dots">
                          {p.imagenes.map((_, i) => (
                            <button
                              type="button"
                              class={`prod__dot${i === 0 ? " is-on" : ""}`}
                              data-dot={i}
                              aria-label={`Ver imagen ${i + 1}`}
                            ></button>
                          ))}
                        </div>
                      )}
                    </div>
                    <div class="prod__body">
                      <h3>{p.nombre}</h3>
                      <p class="prod__price">{p.precio === 0 ? "0 € (provisional)" : `${p.precio} €`}</p>
                      <p class="prod__desc">{p.descripcion}</p>
                      <details class="prod__more">
                        <summary>Características</summary>
                        <ul>
                          {p.caracteristicas.map((c) => <li>{c}</li>)}
                        </ul>
                      </details>

                      <div class="prod__opts">
                        {p.variantes.map((v) => (
                          <label>
                            {v.nombre}
                            <select data-opt={v.nombre} required>
                              <option value="">Elige…</option>
                              {v.opciones.map((o) => <option value={o}>{o}</option>)}
                            </select>
                          </label>
                        ))}
                        <label>
                          Talla
                          <select data-opt="talla" required>
                            <option value="">Elige…</option>
                            {p.tallas.map((t) => <option value={t}>{t}</option>)}
                          </select>
                        </label>
                        <label class="prod__qty">
                          Uds.
                          <input type="number" data-opt="cantidad" min="1" max="20" value="1" />
                        </label>
                      </div>

                      <button type="button" class="btn btn--primary prod__add" data-add>
                        Añadir al pedido
                      </button>
                      <span class="prod__added" hidden>✓ Añadido</span>
                    </div>
                  </article>
                ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="section section--crema" id="pedido">
      <div class="container">
        <span class="eyebrow">Tu pedido</span>
        <h2 class="section-title">Tramitar pedido</h2>

        <div id="cart-empty" class="cart-empty">
          Aún no has añadido ningún artículo. Elige tallas arriba y pulsa «Añadir al pedido».
        </div>

        <div id="cart-box" hidden>
          <ul id="cart-list" class="cart-list"></ul>

          <form id="pedido-form" class="pedido-form" novalidate>
            <p class="pedido-form__intro">
              Haz la transferencia por el importe que te confirme el club y adjunta aquí el
              justificante. Nos llega tu pedido por email y te contestamos para cerrar la entrega.
            </p>

            <div class="field">
              <label for="p-nombre">Nombre y apellidos <span class="req">*</span></label>
              <input type="text" id="p-nombre" name="nombre" required autocomplete="name" />
            </div>
            <div class="field">
              <label for="p-email">Email <span class="req">*</span></label>
              <input type="email" id="p-email" name="email" required autocomplete="email" />
            </div>
            <div class="field">
              <label for="p-tel">Teléfono <span class="req">*</span></label>
              <input type="tel" id="p-tel" name="telefono" required autocomplete="tel" />
            </div>
            <div class="field">
              <label for="p-notas">Notas del pedido</label>
              <textarea id="p-notas" name="notas" rows="3" placeholder="Nombre y dorsal para personalizar, aclaraciones de tallas, etc."></textarea>
            </div>
            <div class="field">
              <label for="p-file">Comprobante de pago <span class="req">*</span></label>
              <input type="file" id="p-file" name="comprobante" accept="image/*,application/pdf" required />
              <span class="error-msg">Adjunta una imagen o PDF de la transferencia (máx. 8 MB).</span>
            </div>

            <label class="check" for="p-priv">
              <input type="checkbox" id="p-priv" required />
              <span>He leído y acepto la <a href="/privacidad" target="_blank" rel="noopener">política de privacidad</a>. <span class="req">*</span></span>
            </label>

            <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />

            <button type="submit" class="btn btn--primary btn--lg" id="pedido-submit">Realizar pedido</button>
            <p class="form-note">Los pedidos se revisan manualmente. Te respondemos en menos de 48 horas.</p>
          </form>
        </div>

        <div id="pedido-ok" class="form-success" role="status">
          <strong>¡Pedido recibido!</strong><br />
          Hemos enviado tu pedido al club junto con el comprobante. Te contactaremos para
          confirmar tallas y entrega.
        </div>
        <div id="pedido-error" class="pedido-error" role="alert" hidden></div>
      </div>
    </section>
  </main>
  <Footer />

  <a href="#pedido" class="cart-fab" id="cart-fab" hidden>
    Pedido <span id="cart-count">0</span>
  </a>
</Base>

<script>
  const KEY = "mzv-cart";
  const read = () => {
    try {
      return JSON.parse(localStorage.getItem(KEY) || "[]");
    } catch {
      return [];
    }
  };
  const write = (c) => {
    try {
      localStorage.setItem(KEY, JSON.stringify(c));
    } catch {}
  };

  const listEl = document.getElementById("cart-list");
  const emptyEl = document.getElementById("cart-empty");
  const boxEl = document.getElementById("cart-box");
  const fab = document.getElementById("cart-fab");
  const countEl = document.getElementById("cart-count");

  function render() {
    const cart = read();
    const total = cart.reduce((n, l) => n + l.cantidad, 0);
    countEl.textContent = String(total);
    fab.hidden = total === 0;
    emptyEl.hidden = cart.length > 0;
    boxEl.hidden = cart.length === 0;
    listEl.innerHTML = cart
      .map(
        (l, i) => `
      <li class="cart-line">
        <span class="cart-line__name">${l.nombre}</span>
        <span class="cart-line__meta">${[l.variante, l.talla ? "Talla " + l.talla : ""].filter(Boolean).join(" · ")} · ${l.cantidad} ud.</span>
        <button type="button" class="cart-line__del" data-del="${i}" aria-label="Quitar">✕</button>
      </li>`,
      )
      .join("");
  }

  listEl?.addEventListener("click", (e) => {
    const b = e.target.closest("[data-del]");
    if (!b) return;
    const cart = read();
    cart.splice(Number(b.dataset.del), 1);
    write(cart);
    render();
  });

  document.querySelectorAll(".prod").forEach((card) => {
    // carrusel de imágenes
    card.querySelectorAll("[data-dot]").forEach((dot) => {
      dot.addEventListener("click", () => {
        const n = dot.dataset.dot;
        card.querySelectorAll("[data-shot]").forEach((img) => (img.hidden = img.dataset.shot !== n));
        card.querySelectorAll("[data-dot]").forEach((d) => d.classList.toggle("is-on", d === dot));
      });
    });

    const addBtn = card.querySelector("[data-add]");
    const addedTag = card.querySelector(".prod__added");
    addBtn?.addEventListener("click", () => {
      const opts = {};
      let falta = false;
      card.querySelectorAll("[data-opt]").forEach((el) => {
        const k = el.dataset.opt;
        const v = el.value.trim();
        if (k !== "cantidad" && !v) {
          falta = true;
          el.classList.add("prod__opt--err");
        } else {
          el.classList.remove("prod__opt--err");
        }
        opts[k] = v;
      });
      if (falta) return;

      const variante = Object.keys(opts)
        .filter((k) => k !== "talla" && k !== "cantidad")
        .map((k) => opts[k])
        .join(" · ");
      const talla = opts.talla;
      const cantidad = Math.max(1, Math.min(20, parseInt(opts.cantidad || "1", 10)));
      const nombre = card.dataset.nombre;
      const id = card.dataset.prod;

      const cart = read();
      const found = cart.find(
        (l) => l.id === id && l.variante === variante && l.talla === talla,
      );
      if (found) found.cantidad += cantidad;
      else cart.push({ id, nombre, variante, talla, cantidad });
      write(cart);
      render();

      addedTag.hidden = false;
      setTimeout(() => (addedTag.hidden = true), 1800);
    });
  });

  // Envío del pedido
  const form = document.getElementById("pedido-form");
  const okEl = document.getElementById("pedido-ok");
  const errEl = document.getElementById("pedido-error");
  const submitBtn = document.getElementById("pedido-submit");
  const fileEl = document.getElementById("p-file");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errEl.hidden = true;
    const cart = read();
    if (!cart.length) return;

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const f = fileEl.files[0];
    const fieldFile = fileEl.closest(".field");
    if (!f || f.size > 8 * 1024 * 1024) {
      fieldFile.classList.add("field--error");
      return;
    }
    fieldFile.classList.remove("field--error");

    const fd = new FormData(form);
    fd.append("pedido", JSON.stringify(cart));

    submitBtn.disabled = true;
    submitBtn.textContent = "Enviando…";
    try {
      const res = await fetch("/api/pedido", { method: "POST", body: fd });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.ok) {
        write([]);
        render();
        form.style.display = "none";
        okEl.classList.add("show");
        okEl.scrollIntoView({ behavior: "smooth", block: "center" });
      } else {
        throw new Error(data.error || "No se pudo enviar el pedido.");
      }
    } catch (err) {
      errEl.textContent = err.message + " Si sigue fallando, escríbenos por email.";
      errEl.hidden = false;
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Realizar pedido";
    }
  });

  render();
</script>
